{
  "name": "@aurica/sandbox-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root package for Aurica Sandbox",
  "keywords": [],
  "license": "MIT",
  "author": "Kingston Tam",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "turbo run lint format:check test",
    "check:fix": "turbo run lint:fix format test",
    "dev": "tsx watch --env-file-if-exists=.env.development --conditions=@aurica/source packages/sandbox/src/bin/aurica-sandbox.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "release": "turbo run build && changeset publish",
    "start": "tsx --env-file-if-exists=.env.development --conditions=@aurica/source packages/sandbox/src/bin/aurica-sandbox.ts",
    "test": "turbo test"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/vite-react": "7.0.2",
    "@types/node": "^24.12.2",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "oxlint-config-presets": "0.1.8",
    "oxlint-tsgolint": "0.23.0",
    "tsx": "4.22.3",
    "turbo": "2.9.14",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.2.2"
}
