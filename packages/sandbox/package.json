{
  "name": "@aurica/sandbox",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "aurica-sandbox": "./dist/bin/aurica-sandbox.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#src/*.js": {
      "@aurica/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "tsx --conditions=@aurica/source src/bin/aurica-sandbox.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "commander": "14.0.3",
    "consola": "3.4.2",
    "execa": "9.6.1",
    "js-yaml": "4.1.1",
    "mockttp": "4.3.1",
    "ora": "9.4.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/proper-lockfile": "4.1.4",
    "@vitest/coverage-v8": "4.1.5",
    "typescript": "^6.0.3",
    "vitest": "4.1.5"
  }
}
